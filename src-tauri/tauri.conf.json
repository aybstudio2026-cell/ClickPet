{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Click Pet",
  "version": "0.1.0",
  "identifier": "com.abrah.click-pet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "dashboard",
        "title": "Click Pet",
        "width": 800,
        "height": 480,
        "resizable": false,
        "center": true,
        "visible": true,
        "decorations": false,
        "transparent": false
      },
      {
        "label": "overlay",
        "title": "",
        "url": "http://localhost:1420?window=overlay",
        "width": 180,
        "height": 180,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "visible": false,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "publisher": "Tu Empresa",
    "copyright": "Copyright © 2026"
  }
}